VITE_GAMES_API_ORIGIN=http://127.0.0.1:8010

# Leave empty for the same-origin /api/v1 proxy. An APK that bundles the web
# frontend sets this to its HTTPS API, for example https://api.example.com.
VITE_API_BASE_URL=

# Safe defaults: no ad code or reserved space is rendered. `placeholder` is
# visual QA only; `native` emits the mindlab:ad-request bridge event.
VITE_AD_PROVIDER=none
